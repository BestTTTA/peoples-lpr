OCR_API_URL=https://ocrapi.roljetson.com
OCR_API_KEY=

# Postgres (database peoples_lpr in facefinder-postgres on spark).
# Local dev: run `npm run tunnel` first; it forwards localhost:15555 to spark's 127.0.0.1:5555.
DATABASE_URL=postgresql://peoples_lpr:<password>@127.0.0.1:15555/peoples_lpr

# MinIO / S3 (bucket peoples-lpr in facefinder-minio; the user is scoped to that bucket)
S3_ENDPOINT=https://minio-facefinder.roljetson.com
S3_REGION=us-east-1
S3_BUCKET=peoples-lpr
S3_ACCESS_KEY=peoples-lpr
S3_SECRET_KEY=

# Server only (docker-compose.yml on spark): the container reaches Postgres/MinIO by
# their names on FaceFinder's network, so DATABASE_URL/S3_ENDPOINT above are overridden.
# PG_PASSWORD=
# APP_PORT=3300
